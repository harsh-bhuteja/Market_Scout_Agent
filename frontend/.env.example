# Market Scout Agent - Frontend Environment Configuration

# Google OAuth 2.0 Client Configuration
# PUBLIC Google OAuth Client ID for web application (OAuth Consent Screen: Web application)
# NEVER put client secrets in the frontend. Client secrets belong strictly in the backend server.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API Configuration
# Set to true when the FastAPI backend is running at VITE_BACKEND_API_URL
VITE_USE_BACKEND_API=true
VITE_BACKEND_API_URL=http://localhost:8000/api
