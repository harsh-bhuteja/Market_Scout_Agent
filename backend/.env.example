# Market Scout Agent — backend secrets (never commit a real .env)

ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=msa_session
SESSION_TTL_HOURS=12

# Google OAuth Web Client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Adzuna Jobs API
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key
ADZUNA_TIMEOUT_SECONDS=20
ADZUNA_MAX_RETRIES=3

# Groq OpenAI-compatible LLM endpoint
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=your-groq-api-key
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-20b

# Optional FX rates quoted as units per 1 USD
USD_EUR=0.92
USD_GBP=0.79
USD_INR=83.0

MIN_POSTINGS=20
MAX_FETCH_ATTEMPTS=2
BATCH_SIZE=40
